{
  "Comment": "Document ingestion workflow - processes documents and generates embeddings",
  "StartAt": "ProcessDocument",
  "States": {
    "ProcessDocument": {
      "Type": "Task",
      "Resource": "${document_processor_lambda_arn}",
      "Next": "GenerateEmbeddings",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ProcessingFailed"
        }
      ]
    },
    "GenerateEmbeddings": {
      "Type": "Task",
      "Resource": "${embedding_generator_lambda_arn}",
      "Next": "ProcessingSucceeded",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ProcessingFailed"
        }
      ]
    },
    "ProcessingSucceeded": {
      "Type": "Succeed"
    },
    "ProcessingFailed": {
      "Type": "Fail",
      "Error": "DocumentProcessingFailed",
      "Cause": "Failed to process document or generate embeddings"
    }
  }
}
