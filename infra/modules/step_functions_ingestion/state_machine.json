{
  "Comment": "Document ingestion — triggers metadata/suggestions indexer Lambda. Bedrock KB handles chunking and vector embedding separately.",
  "StartAt": "IndexMetadataAndSuggestions",
  "States": {
    "IndexMetadataAndSuggestions": {
      "Type": "Task",
      "Resource": "${document_processor_lambda_arn}",
      "Next": "IngestionSucceeded",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "IngestionFailed"
        }
      ]
    },
    "IngestionSucceeded": {
      "Type": "Succeed"
    },
    "IngestionFailed": {
      "Type": "Fail",
      "Error": "IngestionFailed",
      "Cause": "Metadata/suggestions indexing failed"
    }
  }
}
